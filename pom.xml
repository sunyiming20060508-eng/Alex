<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.linli</groupId>
  <artifactId>life-service-api</artifactId>
  <version>0.1.0</version>

  <properties>
    <java.version>17</java.version>
    <!-- 与苍穹外卖一致用 MyBatis（不是 MyBatis-Plus）：简单 SQL 走注解，动态分页走 XML -->
    <mybatis.starter.version>3.0.4</mybatis.starter.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 真健康检查：/actuator/health 会探 MySQL 和 Redis，不再靠硬编码 UP -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      指标出口：actuator 只有 health 等于"能探活但不能观测"。
      加了 registry-prometheus 之后 /actuator/prometheus 才有东西可抓，
      Nginx 没有代理 /actuator，所以这个端点只在 :8080 本机/内网可达，不对公网暴露。
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!--
      Caffeine：进程内一级缓存，挡在 Redis 前面（com.linli.cache.LocalCache）。
      版本不写死，由 spring-boot-dependencies 管（Boot 3.3.5 → Caffeine 3.1.8）。
      只引这个库、**不引 spring-boot-starter-cache**：@Cacheable 会把"什么时候读、什么时候失效"
      藏进注解里，而本项目刻意手写 cache-aside——和没用 Spring 的缓存抽象是同一个理由
      （见 ShopServiceImpl 的注释）。这里需要的只是"一个会过期、会限容量、可注入假时钟的 Map"。
      为什么值得多一层：L1 省掉的是一次 Redis 往返 + 一次 JSON 反序列化，
      收益和"Redis 离你多远"成正比；本机是回环所以小，实测数字见 docs/WORKLOG.md S-117。
    -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!--
      Flyway：db/migration 下的 V1__…V16__ 早就按 Flyway 命名了，但一直没有引擎，
      靠人手工 source——"这台库跑到第几个脚本了"没人答得上来。接上之后新脚本放进目录就会随启动应用。
      存量库用 baseline-on-migrate + baseline-version 起步（见 application.yml 里的注释）。
      Flyway 10 把 MySQL 支持拆成了独立模块，只加 flyway-core 会在启动时报找不到数据库类型。
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <!-- Bean Validation：@NotBlank/@Size 等注解，替代各 Service 里手写的参数校验 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      阿里云 OSS SDK：只在 linli.upload.mode=oss 时才真正用到，默认仍是本地磁盘适配器。
      3.10.2 和它的传递依赖（jdom2 / httpclient / jaxb-api）本机仓库里都齐，离线可编译。
      JDK 17 已经不带 javax.xml.bind，所以 sky 那份 jaxb-api 也要跟着加，否则 SDK 初始化报 NoClassDefFoundError。
    -->
    <dependency>
      <groupId>com.aliyun.oss</groupId>
      <artifactId>aliyun-sdk-oss</artifactId>
      <version>3.10.2</version>
    </dependency>
    <dependency>
      <groupId>javax.xml.bind</groupId>
      <artifactId>jaxb-api</artifactId>
      <version>2.3.1</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>${mybatis.starter.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- 只为 BCryptPasswordEncoder 引这一个包。**故意不用 spring-boot-starter-security**：
         starter 会装上整条 servlet 过滤器链（默认还要 basic 认证和 CSRF），本项目要的是
         Redis 会话令牌 + @RequiresLogin 拦截器那套自己的鉴权，两者混在一起只会互相打架。 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- CODING_STANDARDS.md 第 1 节要求 Lombok；只参与编译，不打进产物 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
